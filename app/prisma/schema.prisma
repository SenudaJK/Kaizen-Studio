generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// USER & AUTH.JS (NextAuth) TABLES
// ==========================================
model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  name          String?
  image         String?
  // Null when the user only signed up via an OAuth provider (e.g. Google).
  passwordHash  String?
  createdAt     DateTime  @default(now())

  accounts Account[]
  sessions Session[]

  flowRoutines     FlowRoutine[]
  habits           Habit[]
  frictionTriggers FrictionTrigger[]
  fishboneProblems FishboneProblem[]
  spcMetrics       SpcMetric[]
  pdpcPillars      PdpcPillar[]
  arrowNodes       ArrowNode[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ==========================================
// WORKSPACE 1: FLOW CHART & CHECK SHEET
// ==========================================
enum FlowRoutineType {
  MORNING
  EVENING
}

model FlowRoutine {
  id     String          @id @default(cuid())
  userId String
  user   User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  type   FlowRoutineType
  steps  FlowStep[]

  @@unique([userId, type])
}

// What role a step plays in the routine (plain-English labels live in the app).
enum FlowStepKind {
  INPUT // prepare / fuel up
  PROCESS // main action
  GATE // checkpoint that must pass before moving on
  OUTPUT // produces a plan or result
  CORE_CTQ // the one step that matters most ("Critical to Quality")
  AUDIT // review / log
  POKA_YOKE // safeguard that makes a slip hard
  WIND_DOWN // calm-down step
}

model FlowStep {
  id            String       @id @default(cuid())
  flowRoutineId String
  flowRoutine   FlowRoutine  @relation(fields: [flowRoutineId], references: [id], onDelete: Cascade)
  order         Int
  name          String
  durationMin   Int
  kind          FlowStepKind
  logs          FlowStepLog[]

  @@index([flowRoutineId, order])
}

// One row per step per day it was completed. No row = not done that day,
// so every routine resets itself at midnight without any cleanup job.
model FlowStepLog {
  id          String   @id @default(cuid())
  flowStepId  String
  flowStep    FlowStep @relation(fields: [flowStepId], references: [id], onDelete: Cascade)
  date        DateTime @db.Date
  completedAt DateTime @default(now())

  @@unique([flowStepId, date])
}

model Habit {
  id       String      @id @default(cuid())
  userId   String
  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  target    String
  archived  Boolean     @default(false)
  createdAt DateTime    @default(now())
  logs      HabitLog[]
}

enum HabitStatus {
  DONE
  SLIP
  PENDING
}

model HabitLog {
  id       String      @id @default(cuid())
  habitId  String
  habit    Habit       @relation(fields: [habitId], references: [id], onDelete: Cascade)
  date     DateTime    @db.Date
  status   HabitStatus @default(PENDING)

  @@unique([habitId, date])
}

model FrictionTrigger {
  id          String          @id @default(cuid())
  userId      String
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  linkedBone  String? // fishbone problem key this trigger tends to feed
  tallies     FrictionTally[]
}

model FrictionTally {
  id                String          @id @default(cuid())
  frictionTriggerId String
  frictionTrigger   FrictionTrigger @relation(fields: [frictionTriggerId], references: [id], onDelete: Cascade)
  loggedAt          DateTime        @default(now())
  // The user's local calendar day when it was logged, so weekly/monthly counts
  // line up with HabitLog dates regardless of time zone.
  loggedOn          DateTime        @db.Date
  note              String?

  @@index([frictionTriggerId, loggedOn])
}

// ==========================================
// WORKSPACE 2: ROOT-CAUSE STUDIO (FISHBONE)
// Pareto chart is derived from FrictionTally counts, no table needed.
// ==========================================
model FishboneProblem {
  id       String          @id @default(cuid())
  userId   String
  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  key      String // e.g. "workout", "deepwork", "sleep"
  title    String
  causes   FishboneCause[]

  @@unique([userId, key])
}

enum FishboneCategory {
  ENVIRONMENT
  ENERGY
  ROUTINE
  MINDSET
}

model FishboneCause {
  id                String           @id @default(cuid())
  fishboneProblemId String
  fishboneProblem   FishboneProblem  @relation(fields: [fishboneProblemId], references: [id], onDelete: Cascade)
  category          FishboneCategory
  text              String
  fix               String
  isPrimary         Boolean          @default(false)
}

// ==========================================
// WORKSPACE 3: STABILITY & CORRELATIONS (SPC)
// Scatter diagrams are derived by pairing SpcDataPoint series, no table needed.
// ==========================================
enum SpecDirection {
  MIN
  MAX
}

model SpcMetric {
  id            String          @id @default(cuid())
  userId        String
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  key           String // e.g. "sleep", "focus", "screen"
  name          String
  unit          String
  specLimit     Float
  specDirection SpecDirection
  dataPoints    SpcDataPoint[]

  @@unique([userId, key])
}

model SpcDataPoint {
  id          String    @id @default(cuid())
  spcMetricId String
  spcMetric   SpcMetric @relation(fields: [spcMetricId], references: [id], onDelete: Cascade)
  date        DateTime  @db.Date
  value       Float
  note        String?

  @@unique([spcMetricId, date])
}

// ==========================================
// WORKSPACE 4: LIFE DESIGN & PRE-MORTEM (PDPC + ARROW)
// ==========================================
model PdpcPillar {
  id        String         @id @default(cuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  subtitle  String
  order     Int
  scenarios PdpcScenario[]
}

model PdpcScenario {
  id           String     @id @default(cuid())
  pdpcPillarId String
  pdpcPillar   PdpcPillar @relation(fields: [pdpcPillarId], references: [id], onDelete: Cascade)
  risk         String
  counter      String
  active       Boolean    @default(true)
}

enum ArrowPathType {
  CRITICAL_PATH
  PARALLEL_SLACK
}

model ArrowNode {
  id       String        @id @default(cuid())
  userId   String
  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  code     String
  order    Int
  title    String
  duration String
  path     ArrowPathType
  done     Boolean       @default(false)
}
